# Clé API Claude (https://console.anthropic.com) — sert à choisir les meilleurs moments
ANTHROPIC_API_KEY=sk-ant-...

# TikTok for Developers (https://developers.tiktok.com) — app avec le produit "Content Posting API"
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Doit être EXACTEMENT une redirect URI déclarée dans ton app TikTok
TIKTOK_REDIRECT_URI=http://localhost:8765/callback

# YouTube : fichier OAuth "Application de bureau" téléchargé depuis Google Cloud Console
YOUTUBE_CLIENT_SECRETS=client_secret.json

# Transcription locale (faster-whisper) : tiny, base, small, medium, large-v3
WHISPER_MODEL=small
# cpu ou cuda
WHISPER_DEVICE=cpu
# 1 = utiliser les sous-titres automatiques de YouTube quand ils existent (quelques secondes au lieu de minutes)
YOUTUBE_CAPTIONS=1

# Interface web : obligatoire si elle est accessible depuis Internet
# OPENCLIP_USER=admin
# OPENCLIP_PASSWORD=   (généré automatiquement par deploy/install.sh)

# Sur un serveur, YouTube bloque souvent les téléchargements : fichier cookies.txt exporté de ton navigateur
# YTDLP_COOKIES=/chemin/vers/cookies.txt

# Nom et contact affichés sur les pages publiques /legal/terms et /legal/privacy
# (demandées par TikTok et Google pour valider une application)
OPENCLIP_BRAND=OpenClip
OPENCLIP_CONTACT=

# Qualité des vidéos sources (caméra du streamer plus nette, mais fichiers plus lourds)
# SOURCE_MAX_HEIGHT=1440
# LIVE_MAX_HEIGHT=1080
